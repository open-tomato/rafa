{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Core's declarations for the root's ./config subpath, the build's first tsc pass, written into the root's dist",
  "extends": "@open-tomato/rafa-typescript-config/base",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "declarationDir": "../../dist"
  },
  "include": [
    "src/core/config/index.ts",
    "src/core/config/sections.ts",
    "src/core/config/config-schema.ts",
    "src/effort/store/check-rows.ts",
    "src/errors/codes.ts",
    "src/errors/rafa-codes.ts",
    "src/effort/store/findings.ts",
    "src/ports/log-level.ts",
    "src/report/parse.ts",
    "src/adapters/logger/settings.ts",
    "src/bugs/places.ts",
    "src/bugs/record.ts",
    "src/bugs/title.ts",
    "src/config-schema-bugs.ts",
    "src/config-schema-errors.ts",
    "src/config-schema-features.ts",
    "src/config-schema-logger.ts"
  ],
  "references": []
}
