{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.packages.json",
  // Composite, in pr's form, so `tsc --build` builds core, board, effort,
  // inventory, pr and release first and reads their declarations from
  // each package's .tsbuild through the references below. The six are
  // the packages run's sources import, the six its package.json declares:
  // effort is named although board's and release's references bring it
  // in, since `src/start/preflight-sync.ts` imports effort's entry itself.
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["index.ts", "commands.ts", "src"],
  // *.test.ts stays out of check-types, as at the root, until the test
  // type-checking work lands (.rafa/specs/test-type-checking.md).
  "exclude": ["**/*.test.ts"],
  "references": [
    { "path": "../rafa" },
    { "path": "../rafa-board" },
    { "path": "../rafa-effort" },
    { "path": "../rafa-inventory" },
    { "path": "../rafa-pr" },
    { "path": "../rafa-release" }
  ]
}
