{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.packages.json",
  // Composite, so `tsc --build` builds core and the index first and reads
  // their declarations from each one's .tsbuild through the references below.
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["src"],
  // *.test.ts stays out of check-types, as at the root, until the test
  // type-checking work lands (.rafa/specs/test-type-checking.md).
  "exclude": ["**/*.test.ts"],
  "references": [{ "path": "../rafa" }, { "path": "../rafa-index" }]
}
