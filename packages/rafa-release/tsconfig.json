{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.packages.json",
  // Composite, so `tsc --build` builds core, board and effort first and
  // reads their declarations from each package's .tsbuild through the
  // references below; board's own reference to effort and effort's to
  // inventory bring their declarations in.
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["index.ts", "commands.ts", "src"],
  // *.test.ts stays out of check-types, as at the root, until the test
  // type-checking work lands (.rafa/specs/test-type-checking.md).
  "exclude": ["**/*.test.ts"],
  "references": [{ "path": "../rafa" }, { "path": "../rafa-board" }, { "path": "../rafa-effort" }]
}
