{
  "name": "@open-tomato/rafa",
  "version": "0.8.0",
  "description": "Alpha. Runs a plan through the ralph loop: one Claude Code session per task, one commit per task, then a pull request and a CI wait.",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "@open-tomato:registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/rafa.git"
  },
  "homepage": "https://github.com/open-tomato/rafa#readme",
  "bugs": {
    "url": "https://github.com/open-tomato/rafa/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "loop",
    "ralph",
    "cli",
    "bun"
  ],
  "license": "Apache-2.0",
  "author": "Marcos Tomatti <marcos@opentomato.io>",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "module": "./dist/index.js",
  "bin": {
    "rafa": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./plan": "./dist/plan/index.js",
    "./store": "./dist/effort/store/index.js",
    "./ports": "./dist/ports/index.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/rafa.ts --target=bun --outfile=dist/cli.js && bun build src/index.ts src/plan/index.ts src/effort/store/index.ts src/ports/index.ts --target=bun --splitting --root=src --outdir=dist && cp src/PROMPT.md src/plan-prompt.md .claude/skills/dev-planner/SKILL.md dist/ && for tree in pr/plans:plans board/templates:templates; do src=src/${tree%:*}; out=dist/${tree#*:}; [ -d \"$src\" ] || continue; mkdir -p \"$out\" && cp \"$src\"/*.md \"$out\"/ || exit 1; done",
    "prepack": "bun run build",
    "test": "bun test",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "gate:control-bytes": "bun scripts/control-byte-gate/control-byte-gate.ts",
    "snapshot": "bun scripts/snapshot-runtime.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "globals": "^17.12.0",
    "jsonc-eslint-parser": "^3.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}