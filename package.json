{
  "name": "@open-tomato/rafa",
  "version": "0.45.0",
  "description": "Alpha. Runs a plan through the ralph loop: one Claude Code session per task, one commit per task, then a pull request and a CI wait.",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "@open-tomato:registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/rafa.git"
  },
  "homepage": "https://github.com/open-tomato/rafa#readme",
  "bugs": {
    "url": "https://github.com/open-tomato/rafa/issues"
  },
  "keywords": [
    "claude-code",
    "agent",
    "loop",
    "ralph",
    "cli",
    "bun"
  ],
  "license": "Apache-2.0",
  "openTomato": {
    "team": "@open-tomato/maintainers"
  },
  "author": "Marcos Tomatti <marcos@opentomato.io>",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "module": "./dist/index.js",
  "bin": {
    "rafa": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./plan": "./dist/plan/index.js",
    "./store": "./dist/effort/store/index.js",
    "./ports": "./dist/ports/index.js",
    "./learning": "./dist/learning/index.js",
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./core/config": {
      "types": "./dist/core/config/index.d.ts"
    },
    "./core/config/config-schema": {
      "types": "./dist/core/config/config-schema.d.ts"
    },
    "./core/config/sections": {
      "types": "./dist/core/config/sections.d.ts"
    },
    "./errors/codes": {
      "types": "./dist/errors/codes.d.ts"
    },
    "./errors/rafa-codes": {
      "types": "./dist/errors/rafa-codes.d.ts"
    },
    "./ports/log-level": {
      "types": "./dist/ports/log-level.d.ts"
    },
    "./report/parse": {
      "types": "./dist/report/parse.d.ts"
    },
    "./store/check-rows": {
      "types": "./dist/effort/store/check-rows.d.ts"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "rm -rf dist && bun scripts/build/bundle.ts && tsc -p packages/rafa/tsconfig.types.json && tsc -p tsconfig.config-types.json && cp src/PROMPT.md src/plan-prompt.md src/epic-verify-prompt.md src/continue-decision-prompt.md src/continue-criteria.md dist/ && cp -R src/bundled dist/bundled && bun build src/tools/ts-symbols/cli.ts --target=bun --outfile=dist/bundled/bin/ts-symbols && for tree in pr/plans:plans board/templates:templates release/templates:release-templates; do src=src/${tree%:*}; out=dist/${tree#*:}; [ -d \"$src\" ] || continue; mkdir -p \"$out\" || exit 1; copied=0; for asset in \"$src\"/*.md \"$src\"/*.yml; do [ -e \"$asset\" ] || continue; cp \"$asset\" \"$out\"/ || exit 1; copied=1; done; [ $copied = 1 ] || exit 1; done",
    "prepack": "bun run build",
    "test": "bun test",
    "lint": "eslint .",
    "check-types": "tsc --noEmit && bun run --filter './packages/*' check-types",
    "verify:affected": "turbo run lint check-types test --affected",
    "codeowners": "bun scripts/codeowners.ts",
    "gate:control-bytes": "bun scripts/control-byte-gate/control-byte-gate.ts",
    "snapshot": "bun scripts/snapshot-runtime.ts",
    "stretch": "bash scripts/stretch/stretch.sh",
    "device:check": "bash scripts/device/check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/markdown": "^8.0.3",
    "@open-tomato/define-config": "0.5.0",
    "@open-tomato/rafa-core": "workspace:*",
    "@open-tomato/rafa-eslint-config": "workspace:*",
    "@open-tomato/rafa-typescript-config": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "globals": "^17.12.0",
    "jsonc-eslint-parser": "^3.1.0",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}