{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Workspace packages and the root: core's subpaths mapped to packages/rafa/src, see context/source.md",
  "extends": "@open-tomato/rafa-typescript-config/base",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@open-tomato/rafa/store": ["./packages/rafa/src/effort/store/index.ts"],
      "@open-tomato/rafa/ports": ["./packages/rafa/src/ports/index.ts"],
      "@open-tomato/rafa/store/*": ["./packages/rafa/src/effort/store/*"],
      "@open-tomato/rafa/*": ["./packages/rafa/src/*"]
    }
  }
}
