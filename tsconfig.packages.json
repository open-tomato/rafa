{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Workspace packages: core subpaths mapped to source, see context/source.md",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@open-tomato/rafa/store": ["./src/effort/store/index.ts"],
      "@open-tomato/rafa/ports": ["./src/ports/index.ts"]
    }
  }
}
