{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.packages.json",
  // Composite; references every workspace package it declares, so their
  // declarations are built first.
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["index.ts", "src"],
  "exclude": ["**/*.test.ts", "src/testdata"],
  "references": [
    { "path": "../../packages/rafa" }
  ]
}
