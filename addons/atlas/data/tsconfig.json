{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.packages.json",
  // Composite, so `tsc --build` over the solution file builds it in order.
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["index.ts", "src"],
  // *.test.ts stays out of check-types, as at the root.
  "exclude": ["**/*.test.ts"]
}
