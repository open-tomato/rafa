{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.packages.json",
  // `paths` points atlas-ui's entries at their source, so the demo (tsc and
  // Bun alike) runs against it without a build first. `@open-tomato/charts`
  // comes from npm, read through its published declarations.
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@open-tomato/atlas-ui": ["../ui/src/index.ts"],
      "@open-tomato/atlas-ui/contract": ["../ui/src/contract/index.ts"]
    }
  },
  "include": ["index.ts", "src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"],
  "references": [
    { "path": "../data" },
    { "path": "../transport" },
    { "path": "../ui" },
    { "path": "../rafa-atlas" }
  ]
}
