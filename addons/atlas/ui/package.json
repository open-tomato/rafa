{
  "name": "@open-tomato/atlas-ui",
  "version": "0.0.0",
  "description": "React 19 card library for Atlas: atoms to templates, the card cascade with its four modes, and the card contract as zod schemas, over @open-tomato/charts. The consuming app ships the token values.",
  "license": "Apache-2.0",
  "openTomato": {
    "team": "@open-tomato/maintainers"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/rafa.git",
    "directory": "addons/atlas/ui"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "source": "./src/contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "@open-tomato:registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check-types": "tsc --build && tsc -p tsconfig.stories.json",
    "lint": "eslint .",
    "test": "bun test",
    "build": "rm -rf dist && NODE_ENV=production bun scripts/build.ts && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6007",
    "build:storybook": "storybook build --quiet --output-dir storybook-static",
    "check:stories": "bun scripts/check-stories.ts storybook-static",
    "test:visual": "playwright test --config visual/playwright.config.ts",
    "test:visual:update": "playwright test --config visual/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@open-tomato/charts": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.67.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@open-tomato/eslint-config": "^0.1.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "happy-dom": "^21.0.4",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
