{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  // The second half of `check-types`: the stories and the tooling around
  // them (.storybook, scripts, visual, the test preload). None of it ships,
  // and a story's `const meta = { ... } satisfies Meta<typeof C>` cannot
  // carry the annotation `isolatedDeclarations` asks for, so the flag is off.
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "tsBuildInfoFile": null,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "isolatedDeclarations": false,
    "rootDir": "."
  },
  "include": ["src/**/*.stories.tsx", "src/stories", ".storybook", "scripts", "visual", "test"],
  "exclude": [],
  // Not inherited through `extends`: `@open-tomato/charts` is read from the
  // declarations its own build writes, never compiled here.
  "references": [{ "path": "../charts" }]
}
