{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  // The `.d.ts` half of `bun run build`: declarations into dist/ beside
  // bun build's JavaScript. Stories and tests never ship.
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "tsBuildInfoFile": null,
    "outDir": "dist"
  },
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx"]
}
