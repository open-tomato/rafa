{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  // The `.d.ts` half of `bun run build`: declarations into dist/ beside
  // bun build's JavaScript. Stories and tests never ship. `references` is
  // not inherited through `extends`, so it is named again: tsc then reads
  // `@open-tomato/charts` from that package's declarations, which
  // `check-types` (`tsc --build`) writes first.
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "tsBuildInfoFile": null,
    "outDir": "dist"
  },
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx"],
  "references": [{ "path": "../charts" }]
}
