{
  "name": "@open-tomato/charts",
  "version": "0.0.0",
  "description": "React 19 charting for the @open-tomato scope: a chart-engine seam over ECharts 6, the theme token names, formatters, and a headless engine subpath.",
  "license": "Apache-2.0",
  "openTomato": {
    "team": "@open-tomato/maintainers"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-tomato/rafa.git",
    "directory": "addons/atlas/charts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./engine": {
      "types": "./dist/engine/headless/index.d.ts",
      "import": "./dist/engine/headless/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "@open-tomato:registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check-types": "tsc --build && tsc -p tsconfig.stories.json",
    "lint": "eslint .",
    "test": "bun test",
    "build": "rm -rf dist && NODE_ENV=production bun build ./src/index.ts ./src/theme/index.ts ./src/engine/headless/index.ts --root ./src --outdir ./dist --target browser --format esm --splitting --packages external && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build --quiet --output-dir storybook-static",
    "check:stories": "bun scripts/check-stories.ts storybook-static",
    "test:visual": "playwright test --config visual/playwright.config.ts",
    "test:visual:update": "playwright test --config visual/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@open-tomato/rafa-eslint-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "happy-dom": "^21.0.4",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
